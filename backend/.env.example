# Copy to .env and fill in values
APP_NAME=DClaw Waste
APP_ENV=dev
DEBUG=true

# PostgreSQL — matches docker-compose defaults
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_waste

# Security — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI (optional — copilot/classifier works without this)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Stripe (optional — invoices work in demo mode without this)
STRIPE_API_KEY=
STRIPE_SUCCESS_URL=http://localhost:3056/invoices?paid=1
STRIPE_CANCEL_URL=http://localhost:3056/invoices
