# Copy to .env and fill in values
APP_NAME=DClaw Waste
APP_ENV=dev
DEBUG=true

# PostgreSQL — matches docker-compose defaults
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_waste

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# AI (optional — copilot works in rule-based mode without this)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
